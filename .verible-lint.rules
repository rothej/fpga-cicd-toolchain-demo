# .verible-lint.rules
# Based on systemverilog.io style guide

# Allow traditional lowercase_with_underscore for variables, modules, classes
-parameter-name-style

# Allow lowercase_with_underscore for modules
-module-filename

# Keep line length check enabled
+line-length=length:100

# Enforce explicit parameter types
+explicit-parameter-storage-type

# Require explicit lifetime for tasks/functions
+explicit-task-lifetime
+explicit-function-lifetime

# Whitespace
+no-trailing-spaces
+no-tabs

# Keep check for proper file endings
+posix-eof

# Good Practices
+always-comb
+always-comb-blocking
+always-ff-non-blocking
+typedef-enums
+typedef-structs-unions
+forbid-defparam
+suggest-parentheses
+packed-dimensions-range-ordering

# Disable overly strict rules for testbenches
# Allow x and z in literals without full width
-undersized-binary-literal

# Allow generate blocks without explicit labels
-generate-label
-generate-label-prefix
